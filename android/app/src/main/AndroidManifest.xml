<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Speaking tasks: the microphone is requested on first use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Daily reminder: notification, and re-arming the alarm after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app find the phone's text-to-speech and speech recognition services on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup="false": the secret key and the save live in the WebView's storage, both unencrypted there
         (only the backup on the server is encrypted), and must not end up in Google's cloud backup (see PRIVACY.md).
         The player keeps the key themselves. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.OpenSprachFuchs">

        <activity
            android:name=".MainActivity"
            android:label="@string/launcher_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Friend links from QR codes (https://<backend>/f#CODE/Name) open the app directly (App Link,
                 verified through /.well-known/assetlinks.json on the backend). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${linkHost}" android:path="/f" />
                <data android:scheme="https" android:host="${linkHostOld}" android:path="/f" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".StreakWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget" />
        </receiver>

        <!-- TIME_SET and TIMEZONE_CHANGED may still be declared here since Android 8, DATE_CHANGED may not;
             the change of day therefore comes from an alarm of our own (Reminders.scheduleMidnight).
             Not exported (issue #47): other apps cannot trigger it. The alarms are explicit PendingIntents of the
             app itself, and the system still delivers its own broadcasts (boot, time, time zone) to it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
